import os
import csv
import re

from connect_with_db import get_connection


DOWNLOAD_DIR = "downloads"


def get_table_name(file_name):

    table_name = os.path.splitext(file_name)[0]

    table_name = table_name.lower()

    table_name = re.sub(r"[^a-zA-Z0-9_]","_",table_name)

    if table_name[0].isdigit():
        table_name = "table_" + table_name

    return table_name


def get_csv_headers(csv_file):

    with open(csv_file, "r", encoding="utf-8", errors="replace") as file:
        reader = csv.reader(file)
        headers = next(reader)

    return headers


def create_table(connection, table_name, headers):
    columns = []
    for header in headers:
        header = header.strip()
        if not header:
            header = "unknown_column"

        columns.append(f'"{header}" TEXT')

    columns_sql = ", ".join(columns)

    query = f"""
        CREATE TABLE IF NOT EXISTS "{table_name}" (
            {columns_sql}
        );
    """

    with connection.cursor() as cursor:
        cursor.execute(query)

    connection.commit()
    print(f"Table ready : {table_name}")


def bulk_insert_csv(connection,table_name,csv_file):

    query = f"""
        COPY "{table_name}"
        FROM STDIN
        WITH (
            FORMAT CSV,
            HEADER TRUE
        );
    """

    with connection.cursor() as cursor:

        with open(csv_file, "r", encoding="utf-8", errors="replace") as file:

            with cursor.copy(query) as copy:
                while True:
                    data = file.read(1024 * 1024)

                    if not data: break

                    copy.write(data)

    connection.commit()

    print(f"Uploaded    : {os.path.basename(csv_file)}")


def upload_csv_file(connection,csv_file):

    file_name = os.path.basename(csv_file)

    table_name = get_table_name(file_name)

    print("\n--------------------------------")
    print("File  :", file_name)
    print("Table :", table_name)

    headers = get_csv_headers(csv_file)

    print("Columns:",len(headers))

    create_table(connection,table_name,headers)

    bulk_insert_csv(connection,table_name,csv_file)


def upload_all_csv_files():

    # Use your existing DB connection
    connection = get_connection()

    try:

        for root, directories, files in os.walk(DOWNLOAD_DIR):

            for file_name in files:
                if not file_name.lower().endswith(".csv"):
                    continue

                csv_file = os.path.join(root,file_name)

                try:
                    upload_csv_file(connection,csv_file)

                except Exception as error:
                    connection.rollback()
                    print(f"\nFailed : {file_name}")
                    print(f"Error  : {error}")

    finally:
        connection.close()
        print("\nDatabase connection closed.")

if __name__ == "__main__":
    upload_all_csv_files()